    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.470.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3"
  }
