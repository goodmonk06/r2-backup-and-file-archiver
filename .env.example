# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/r2backup?schema=public

# Cloudflare R2 Configuration
# R2のアクセスキーとシークレットキー（Cloudflareダッシュボードで作成）
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# R2エンドポイント（通常は https://<ACCOUNT_ID>.r2.cloudflarestorage.com）
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# バックアップ設定ファイルのパス
BACKUP_CONFIG_PATH=./config/backup.yml

# API Server
PORT=3000
NODE_ENV=development

# ログレベル（debug, info, warn, error）
LOG_LEVEL=info
